{
  "server": {
    "listen": "127.0.0.1:8080",
    "auth_token_env": "HEALTHZ_API_TOKEN"
  },
  "smtp": {
    "enabled": true,
    "host": "smtp.example.com",
    "port": 587,
    "tls": "starttls",
    "username": "monitor@example.com",
    "password_env": "HEALTHZ_SMTP_PASSWORD",
    "from": "monitor@example.com",
    "to": ["alerts@example.com"]
  },
  "alerts": {
    "failure_threshold": 2,
    "send_recovery": true,
    "repeat_interval": "1h"
  },
  "status_digest": {
    "enabled": true,
    "send_at": "08:00",
    "timezone": "Europe/Copenhagen"
  },
  "storage": {
    "path": "data/healthz.db",
    "history_retention_days": 30
  },
  "endpoints": [
    {
      "name": "Main website",
      "url": "https://example.com/",
      "method": "GET",
      "frequency": "1m",
      "timeout": "10s",
      "expected_statuses": [200],
      "body_contains": "Example Domain"
    },
    {
      "name": "Public API",
      "url": "https://api.example.com/health",
      "method": "GET",
      "frequency": "30s",
      "schedule_jitter": "5s",
      "timeout": "5s",
      "expected_statuses": [200],
      "recheck_before_alert": true,
      "flapping": {
        "enabled": true,
        "transitions": 4,
        "window": "10m"
      },
      "headers": {
        "Accept": "application/json"
      },
      "alert_to": [
        "api-team@example.com",
        "operations@example.com"
      ],
      "alert_subjects": {
        "down": "[CRITICAL] {name} failed {failures} checks",
        "recovered": "[RESOLVED] {name} returned HTTP {status}",
        "flapping": "[UNSTABLE] {name}: {transitions} changes in {window}"
      },
      "failure_threshold": 3
    }
  ]
}
