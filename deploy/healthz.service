[Unit]
Description=healthz website monitoring service
Documentation=https://github.com/runeQ/healthz
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=healthz
Group=healthz
WorkingDirectory=/var/lib/healthz
EnvironmentFile=-/etc/healthz/healthz.env
ExecStart=/usr/local/bin/healthz -config /etc/healthz/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

StateDirectory=healthz
StateDirectoryMode=0700
ConfigurationDirectory=healthz
ConfigurationDirectoryMode=0750
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/healthz
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
KeyringMode=private
ProtectHostname=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
