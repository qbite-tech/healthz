HEALTHZ_SMTP_PASSWORD=your-smtp-app-password
# Bootstrap fallback; optional after creating a personal database token.
# Generate with: openssl rand -hex 32
HEALTHZ_API_TOKEN=YOUR_RANDOM_API_TOKEN
# Only needed for postgres endpoints; name it in the endpoint's dsn_env.
# HEALTHZ_APP_DSN=postgres://monitor_user:password@db.example.com:6432/app?sslmode=require
# Only needed for ping endpoints; name it in the endpoint's ping_key_env.
# Generate with: openssl rand -hex 16
# HEALTHZ_BACKUP_PING_KEY=YOUR_RANDOM_PING_KEY
